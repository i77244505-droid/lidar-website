# Copy this file to .env for local plaintext development, or use:
#   npm run env:encrypt
# to store the values in .env.enc with a private local .env.key.

PORT=3000
HOST=127.0.0.1
ALLOW_REMOTE=false

# Optional: require a token for WebSocket control commands.
# Put the same value in browser localStorage key "lidar_control_token"
# or connect with ?token=...
CONTROL_TOKEN=

# Serial
SERIAL_PORT=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LiDAR System <no-reply@example.com>"
